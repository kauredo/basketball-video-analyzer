{
  "name": "basketball-video-analyzer",
  "version": "1.15.0",
  "description": "Desktop app for cutting and categorizing basketball video clips for team scouting",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "webpack --mode=production",
    "dev": "concurrently \"npm run build:main\" \"npm run dev:renderer\" \"wait-on dist/main/main.js && electron-forge start\"",
    "dev:renderer": "webpack --mode=development --watch",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "npm run build && npm run make",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "stats:downloads": "node scripts/download-stats.mjs",
    "lint:locales": "node scripts/lint-locales.mjs",
    "test": "node --experimental-strip-types --test src/main/*.test.mts src/shared/*.test.mts src/renderer/utils/*.test.mts scripts/*.test.mts",
    "notices": "node scripts/third-party-notices.mjs",
    "prebuild": "npm run lint:locales"
  },
  "keywords": [
    "basketball",
    "video",
    "clips",
    "scouting",
    "electron"
  ],
  "build": {
    "npmRebuild": true,
    "nodeGypRebuild": false
  },
  "author": {
    "name": "Basketball Video Analyzer Team",
    "email": "contact@basketballvideoanalyzer.com"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/kauredo/basketball-video-analyzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/kauredo/basketball-video-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/kauredo/basketball-video-analyzer/issues"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^28.0.0",
    "electron-rebuild": "^3.2.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "better-sqlite3": "^9.2.2",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "fluent-ffmpeg": "^2.1.2",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.3",
    "update-electron-app": "^3.3.0",
    "yazl": "^3.3.1",
    "youtube-dl-exec": "^3.1.3"
  },
  "overrides": {
    "node-gyp": "^12.4.0"
  },
  "trustedDependencies": [
    "youtube-dl-exec"
  ]
}
